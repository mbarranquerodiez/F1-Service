<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const circuit = <%- JSON.stringify(circuit || {}) %>;
  console.log('Datos del circuito en JS:', circuit);  // Log para debug
  
  const mapDiv = document.getElementById('map');
  if (!mapDiv) {
    console.error('Div #map no encontrado');
    return;
  }
  
  if (circuit && circuit.geometry && circuit.geometry.coordinates) {
    try {
      // Inicializar mapa con view default (evita fitBounds directo)
      const map = L.map('map').setView([35, 139], 10);  // Default aproximado para Suzuka/Japón; ajusta si necesitas global
      
      // Configurar tiles
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 18
      }).addTo(map);
      
      // Preparar coordinates para Leaflet: asume MySQL [lng, lat] → Leaflet [lat, lng]
      const leafletCoords = circuit.geometry.coordinates.map(function(c) { return [c[1], c[0]]; });
      console.log('Primeros coordinates en Leaflet format:', leafletCoords.slice(0, 3));  // Log sample
      
      // Dibujar la polilínea
      if (circuit.geometry.type === 'LineString' && Array.isArray(leafletCoords) && leafletCoords.length > 1) {
        L.polyline(leafletCoords, {
          color: '#ff0000',
          weight: 5,
          opacity: 0.8
        }).addTo(map);
        
        console.log('Polilínea añadida con', leafletCoords.length, 'puntos');
      }
      
      // Calcular bounds VÁLIDOS (prioridad: bbox, fallback coordinates)
      let bounds = null;
      
      // Intentar bbox
      if (circuit.bbox) {
        console.log('Bbox raw:', circuit.bbox);  // Log el bbox exacto para debug
        try {
          // Si bbox es [[minLng, minLat], [maxLng, maxLat]]
          if (Array.isArray(circuit.bbox) && circuit.bbox.length === 2 && Array.isArray(circuit.bbox[0])) {
            const bboxLeaflet = circuit.bbox.map(function(corner) { return [corner[1], corner[0]]; });
            bounds = L.latLngBounds(bboxLeaflet);
            console.log('Bbox válido usado');
          } else {
            console.warn('Bbox formato no soportado directamente; usando coordinates');
          }
        } catch (e) {
          console.warn('Error en bbox:', e);
        }
      }
      
      // Fallback: bounds de coordinates si no hay bbox válido
      if (!bounds && leafletCoords.length > 1) {
        try {
          bounds = L.latLngBounds(leafletCoords);
          console.log('Bounds calculados de coordinates');
        } catch (e) {
          console.warn('Error calculando bounds de coordinates:', e);
        }
      }
      
      // Fit si hay bounds válidos
      if (bounds && bounds.isValid()) {
        map.fitBounds(bounds, { padding: [20, 20], maxZoom: 18 });
        console.log('Mapa fitted a bounds válidos');
      } else {
        console.warn('No bounds válidos; manteniendo view default');
        // Opcional: zoom manual si sabes approx (ej. para Suzuka: map.setView([34.843, 136.541], 16);)
      }
      
    } catch (error) {
      console.error('Error inicializando mapa:', error);
      mapDiv.innerHTML = '<div class="alert alert-danger" role="alert">Error al cargar el mapa: ' + error.message + '</div>';
    }
  } else {
    console.warn('No geometry o coordinates válidos');
    mapDiv.innerHTML = '<p class="text-center text-muted">Mapa no disponible (datos de geometría incompletos).</p>';
  }
});
</script>

