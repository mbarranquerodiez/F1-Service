<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="" />
<title>Info1 - Detalles de la Carrera</title>
<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet"
integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
crossorigin="anonymous"
/>
<link
href="https://fonts.googleapis.com/css?family=Playfair+Display:700,900&display=swap"
rel="stylesheet"
/>
<link href="/src/css/allRaces.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<meta name="theme-color" content="#712cf9" />
<style>
.chart-container {
  position: relative;
  height: 300px;
  width: 100%;
  margin-top: 20px;
}
.weather-card {
  margin-bottom: 20px;
}
</style>
</head>
<body>
<div class="container-fluid">
<header class="border-bottom lh-1 py-3">
  <div class="row flex-nowrap justify-content-center align-items-center">
    <div class="col-4 text-center">
      <a class="blog-header-logo text-decoration-none" href="/home">
        <img src="/src/public/LogoInfo1.png" alt="Info1" style="max-height: 100px; width: auto;">
      </a>
    </div>
  </div>
</header>
<div class="nav-scroller py-1 mb-3 border-bottom">
<nav class="nav nav-underline justify-content-between">
<a class="nav-item nav-link link-body-emphasis" href="/home">Home</a>
<a class="nav-item nav-link link-body-emphasis active" href="/getRacesByYear">Carreras</a>
<a class="nav-item nav-link link-body-emphasis" href="/getDriversByYear">Pilotos</a>
<a class="nav-item nav-link link-body-emphasis" href="/circuits">Circuitos</a>
<a class="nav-item nav-link link-body-emphasis" href="/gallery">Galería</a>
</nav>
</div>
</div>

<main class="container-fluid">
<div class="p-4 p-md-5 mb-4 rounded text-body-emphasis bg-dark">
<div class="row justify-content-center">
<div class="col-lg-12 text-center">
<h1 class="display-4 fst-italic">Fórmula 1</h1>
<p class="lead my-3">Detalles Meteorológicos de la Carrera</p>
</div>
</div>

<div class="row">
<div class="col-md-12">
<% if (!infoRaceDetails || !infoRaceDetails.raceDetails) { %>
<div class="alert alert-warning" role="alert">No se encontraron detalles para esta carrera.</div>
<% } else { const raceDetails = infoRaceDetails.raceDetails; %>

<!-- Información general de la carrera -->
<section class="weather-card card bg-secondary text-light mb-4">
<div class="card-body">
<h2 class="card-title">Información de la Carrera</h2>
<div class="row">
<div class="col-md-6">
<p><strong>Ciudad:</strong> <%= raceDetails.city %></p>
<p><strong>País:</strong> <%= raceDetails.country %></p>
<p><strong>Fecha:</strong> <%= raceDetails.date %></p>
<p><strong>Hora Local del Circuito:</strong> <%= raceDetails.raceTime %> <% if (raceDetails.timezone) { %>(<%= raceDetails.timezone %>)<% } %></p>
<% if (raceDetails.raceTimeSpain) { %>
<p><strong>Hora en España:</strong> <%= raceDetails.raceTimeSpain %> (CET/CEST)</p>
<% } %>
</div>
<div class="col-md-6">
<h4>Condiciones en Hora de Carrera</h4>
<p><strong>Temperatura:</strong> <%= raceDetails.temperature %>°C</p>
<p><strong>Lluvia:</strong> <%= raceDetails.rain ? raceDetails.rain + ' mm' : 'Sin lluvia' %></p>
</div>
</div>
</div>
</section>

<!-- Resultados de la Carrera -->
<% if (infoRaceResults && infoRaceResults.results && infoRaceResults.results.length > 0) { %>
<section class="weather-card card bg-secondary text-light mb-4">
<div class="card-body">
<h2 class="card-title">Resultados de la Carrera</h2>
<div class="table-responsive">
<table class="table table-dark table-striped table-hover">
<thead>
<tr>
<th>Pos</th>
<th>Piloto</th>
<th>Equipo</th>
<th>Grid</th>
<th>Tiempo</th>
<th>Puntos</th>
<th>Estado</th>
</tr>
</thead>
<tbody>
<% infoRaceResults.results.forEach(result => { %>
<tr>
<td><strong><%= result.position %></strong></td>
<td>
<span class="badge bg-primary"><%= result.driver.shortName %></span>
<%= result.driver.name %> <%= result.driver.surname %>
</td>
<td><%= result.team.teamName %></td>
<td><%= result.grid %></td>
<td><%= result.time || (result.retired ? 'Retirado' : '-') %></td>
<td><strong><%= result.points %></strong></td>
<td>
<% if (result.retired) { %>
<span class="badge bg-danger"><%= result.retired %></span>
<% } else if (result.position === 1) { %>
<span class="badge bg-success">Ganador</span>
<% } else if (result.position <= 3) { %>
<span class="badge bg-info">Podio</span>
<% } else if (result.position <= 10) { %>
<span class="badge bg-secondary">Puntos</span>
<% } else { %>
<span class="text-muted">-</span>
<% } %>
</td>
</tr>
<% }); %>
</tbody>
</table>
</div>
</div>
</section>
<% } %>

<!-- Gráfico de temperatura -->
<section class="weather-card card bg-secondary text-light mb-4">
<div class="card-body">
<h3 class="card-title">Temperatura del Día</h3>
<div class="chart-container">
<canvas id="temperatureChart"></canvas>
</div>
</div>
</section>

<!-- Gráfico de precipitaciones -->
<section class="weather-card card bg-secondary text-light mb-4">
<div class="card-body">
<h3 class="card-title">Precipitación del Día</h3>
<div class="chart-container">
<canvas id="precipitationChart"></canvas>
</div>
</div>
</section>

<a href="/getRacesByYear" class="btn btn-primary mb-3">Volver a Carreras</a>
<% } %>
</div>
<div class="col-12 text-center mt-3">
<p class="lead mb-0">
<a href="/logout" class="text-danger fw-bold">Cerrar sesión</a>
</p>
</div>
</div>
</div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function() {
<% if (infoRaceDetails && infoRaceDetails.raceDetails && infoRaceDetails.raceDetails.hourlyData) { %>
const hourlyData = <%- JSON.stringify(infoRaceDetails.raceDetails.hourlyData) %>;
const raceTime = '<%= infoRaceDetails.raceDetails.raceTime %>';

// Gráfico de temperatura
const tempCtx = document.getElementById('temperatureChart');
if (tempCtx) {
    new Chart(tempCtx, {
        type: 'line',
        data: {
            labels: hourlyData.map(d => d.time),
            datasets: [{
                label: 'Temperatura (°C)',
                data: hourlyData.map(d => d.temperature),
                borderColor: 'rgb(255, 99, 132)',
                backgroundColor: 'rgba(255, 99, 132, 0.2)',
                tension: 0.1,
                pointBackgroundColor: hourlyData.map(d => d.time === raceTime ? 'rgb(75, 192, 192)' : 'rgb(255, 99, 132)'),
                pointRadius: hourlyData.map(d => d.time === raceTime ? 8 : 3),
                pointHoverRadius: hourlyData.map(d => d.time === raceTime ? 10 : 5)
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    labels: { color: '#fff' }
                },
                tooltip: {
                    callbacks: {
                        title: function(context) {
                            const time = context[0].label;
                            return time === raceTime ? time + ' (HORA DE LA CARRERA)' : time;
                        }
                    }
                }
            },
            scales: {
                y: {
                    ticks: { color: '#fff' },
                    grid: { color: 'rgba(255, 255, 255, 0.1)' }
                },
                x: {
                    ticks: { color: '#fff' },
                    grid: { color: 'rgba(255, 255, 255, 0.1)' }
                }
            }
        }
    });
}

// Gráfico de precipitación
const precCtx = document.getElementById('precipitationChart');
if (precCtx) {
    new Chart(precCtx, {
        type: 'bar',
        data: {
            labels: hourlyData.map(d => d.time),
            datasets: [{
                label: 'Precipitación (mm)',
                data: hourlyData.map(d => d.rain || 0),
                backgroundColor: hourlyData.map(d => d.time === raceTime ? 'rgba(75, 192, 192, 0.7)' : 'rgba(54, 162, 235, 0.5)'),
                borderColor: hourlyData.map(d => d.time === raceTime ? 'rgb(75, 192, 192)' : 'rgb(54, 162, 235)'),
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    labels: { color: '#fff' }
                },
                tooltip: {
                    callbacks: {
                        title: function(context) {
                            const time = context[0].label;
                            return time === raceTime ? time + ' (HORA DE LA CARRERA)' : time;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { color: '#fff' },
                    grid: { color: 'rgba(255, 255, 255, 0.1)' }
                },
                x: {
                    ticks: { color: '#fff' },
                    grid: { color: 'rgba(255, 255, 255, 0.1)' }
                }
            }
        }
    });
}
<% } %>
});
</script>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
crossorigin="anonymous"
></script>
</body>
</html>
