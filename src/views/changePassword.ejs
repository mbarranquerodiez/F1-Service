<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>INFO1 - Change Password</title>
<link rel="stylesheet" href="/src/css/createAccount.css">
</head>
<body>
<div class="login-container">
<div class="login-card">
<div class="login-header">
<img src="/src/public/LogoInfo1.png" alt="Info1" style="max-height: 80px; width: auto;">
<p>Change your password to keep your account secure</p>
</div>
<form class="login-form" id="changePasswordForm" novalidate>
<div class="form-group">
<div class="input-wrapper">
<input type="text" id="username" name="username" required autocomplete="username" placeholder=" ">
<label for="username">Username</label>
</div>
<span class="error-message" id="usernameError"></span>
</div>
<div class="form-group">
<div class="input-wrapper password-wrapper">
<input type="password" id="oldPassword" name="oldPassword" required autocomplete="current-password" placeholder=" ">
<label for="oldPassword">Current Password</label>
<button type="button" class="password-toggle" id="oldPasswordToggle" aria-label="Toggle password visibility">
<span class="eye-icon"></span>
</button>
</div>
<span class="error-message" id="oldPasswordError"></span>
</div>
<div class="form-group">
<div class="input-wrapper password-wrapper">
<input type="password" id="newPassword" name="newPassword" required autocomplete="new-password" placeholder=" ">
<label for="newPassword">New Password</label>
<button type="button" class="password-toggle" id="newPasswordToggle" aria-label="Toggle password visibility">
<span class="eye-icon"></span>
</button>
</div>
<span class="error-message" id="newPasswordError"></span>
</div>
<div class="form-group">
<div class="input-wrapper password-wrapper">
<input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" placeholder=" ">
<label for="confirmPassword">Confirm New Password</label>
<button type="button" class="password-toggle" id="confirmPasswordToggle" aria-label="Toggle password visibility">
<span class="eye-icon"></span>
</button>
</div>
<span class="error-message" id="confirmPasswordError"></span>
</div>
<button type="submit" class="login-btn">
<span class="btn-text">Change Password</span>
<span class="btn-loader"></span>
</button>
</form>
<div class="signup-link">
<p>Remember your password? <a href="/">Sign In</a></p>
</div>
<div class="success-message" id="successMessage">
<div class="success-icon">✓</div>
<h3>Password Changed Successfully!</h3>
<p>Redirecting to login...</p>
</div>
</div>
</div>
<script>
// changePassword.js
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('changePasswordForm');
  const usernameInput = document.getElementById('username');
  const oldPasswordInput = document.getElementById('oldPassword');
  const newPasswordInput = document.getElementById('newPassword');
  const confirmPasswordInput = document.getElementById('confirmPassword');
  const usernameError = document.getElementById('usernameError');
  const oldPasswordError = document.getElementById('oldPasswordError');
  const newPasswordError = document.getElementById('newPasswordError');
  const confirmPasswordError = document.getElementById('confirmPasswordError');
  const successMessage = document.getElementById('successMessage');
  const submitBtn = form.querySelector('.login-btn');
  const btnText = submitBtn.querySelector('.btn-text');
  const btnLoader = submitBtn.querySelector('.btn-loader');

  // Toggle password visibility
  const togglePassword = (inputId, toggleId) => {
    const input = document.getElementById(inputId);
    const toggle = document.getElementById(toggleId);
    const eyeIcon = toggle.querySelector('.eye-icon');
    if (toggle) {
      toggle.addEventListener('click', () => {
        const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
        input.setAttribute('type', type);
        if (eyeIcon) {
          eyeIcon.classList.toggle('active', type === 'text');
        }
      });
    }
  };
  togglePassword('oldPassword', 'oldPasswordToggle');
  togglePassword('newPassword', 'newPasswordToggle');
  togglePassword('confirmPassword', 'confirmPasswordToggle');

  // Validación client-side
  const validateForm = () => {
    let isValid = true;
    clearErrors();

    const username = usernameInput.value.trim();
    if (!username) {
      showError(usernameError, 'Username is required');
      isValid = false;
    } else if (username.length < 3) {
      showError(usernameError, 'Username must be at least 3 characters');
      isValid = false;
    }

    const oldPassword = oldPasswordInput.value;
    if (!oldPassword) {
      showError(oldPasswordError, 'Current password is required');
      isValid = false;
    }

    const newPassword = newPasswordInput.value;
    if (!newPassword) {
      showError(newPasswordError, 'New password is required');
      isValid = false;
    } else if (newPassword.length < 6) {
      showError(newPasswordError, 'Password must be at least 6 characters');
      isValid = false;
    }

    if (oldPassword && newPassword && oldPassword === newPassword) {
      showError(newPasswordError, 'New password must be different from current password');
      isValid = false;
    }

    const confirmPassword = confirmPasswordInput.value;
    if (confirmPassword !== newPassword) {
      showError(confirmPasswordError, 'Passwords do not match');
      isValid = false;
    }

    return isValid;
  };

  const showError = (element, message) => {
    element.textContent = message;
    element.classList.add('visible');
  };

  const clearErrors = () => {
    [usernameError, oldPasswordError, newPasswordError, confirmPasswordError].forEach(el => {
      el.textContent = '';
      el.classList.remove('visible');
    });
  };

  const showSuccess = () => {
    form.style.display = 'none';
    successMessage.innerHTML = '<div class="success-icon">✓</div><h3>Contraseña actualizada correctamente!</h3><p>Redirigiendo al login...</p>';
    successMessage.style.display = 'block';
    setTimeout(() => {
      window.location.href = '/';
    }, 2000);
  };

  // Submit handler
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validateForm()) return;

    // Mostrar loader
    submitBtn.classList.add('loading');
    btnText.style.opacity = '0';
    btnLoader.style.opacity = '1';

    try {
      const data = {
        username: usernameInput.value.trim(),
        oldPassword: oldPasswordInput.value,
        newPassword: newPasswordInput.value
      };

      const response = await fetch('/users/changepassword', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (response.ok) {  // 200: Éxito
        showSuccess();
      } else if (response.status === 401) {  // No autorizado
        const errorMsg = result.message || 'Usuario o contraseña incorrectos';
        clearErrors();
        if (errorMsg.toLowerCase().includes('usuario') || errorMsg.toLowerCase().includes('encontrado')) {
          showError(usernameError, errorMsg);
        } else {
          showError(oldPasswordError, errorMsg);
        }
      } else if (response.status === 400) {  // Bad request
        const errorMsg = result.message || 'Error en los datos proporcionados';
        clearErrors();
        if (errorMsg.toLowerCase().includes('nueva contraseña') || errorMsg.toLowerCase().includes('igual')) {
          showError(newPasswordError, errorMsg);
        } else {
          showError(usernameError, errorMsg);
        }
      } else {
        // Otros errores (ej. 500)
        const errorMsg = result.message || 'Error al cambiar contraseña';
        showError(usernameError, errorMsg);
      }
    } catch (error) {
      console.error('Error:', error);
      showError(usernameError, 'Error de red. Intenta de nuevo.');
    } finally {
      // Ocultar loader
      submitBtn.classList.remove('loading');
      btnText.style.opacity = '1';
      btnLoader.style.opacity = '0';
    }
  });
});

</script>
</body>
</html>
